# Copy these into Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. This file only lists the names.

# --- shown on the page (not secret) ---
STUDENT_NAME=Your Name
TELEGRAM_BOT_USERNAME=friends_included_yourname_bot
GITHUB_REPO_URL=https://github.com/you/friends-included

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (@BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=any-long-random-string

# --- Google Sheets (service account JSON key) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=name@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=

# --- protects /api/admin (webhook registration, one-off reset) ---
ADMIN_SECRET=another-long-random-string

# optional
DISPLAY_TIMEZONE=Europe/Riga
